// # Streaming MCP Server for Tab Expansion
//
// Logline: JSON-RPC 2.0 stdio server providing sovereign tab expansion, whitespace inspection, and indentation analysis.
//
// Setup: Bridges standard input/output streaming protocol to expansion engines, auditors, and formatters.
//
// Beats:
//   1. Handle MCP initialize handshake with server metadata and capability declarations.
//   2. Expose tools/list catalogue with five sovereign tab expansion tools.
//   3. Dispatch tools/call for expand_text, expand_file, analyze, visualize, and demo.
//   4. Deliver streaming JSON-RPC responses over standard output.

import "core/expand_types.oo";
import "core/expand_engine.oo";
import "core/expand_synthetic.oo";
import "render/render_expanded.oo";
import "render/render_audit.oo";
import "render/render_json.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":"
        + code.to_string() + ",\"message\":\"" + json_escape(msg) + "\"}}\n";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\""
        + json_escape(text) + "\"}]}}\n";
}

pub fn render_mcp_init(id: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id
        + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"ooexpand\",\"version\":\"0.2.0\"}}}\n";
}

pub fn render_mcp_tools_list(id: String) -> String {
    let mut out: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[";
    out = out + "{\"name\":\"expand_text\",\"description\":\"Convert tabs to spaces in text with customizable tab stops.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"tab_stops\":{\"type\":\"string\"},\"initial_only\":{\"type\":\"boolean\"}}}}";
    out = out + ",{\"name\":\"expand_file\",\"description\":\"Read synthetic file sample and expand tabs.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"file_type\":{\"type\":\"string\"},\"tab_stops\":{\"type\":\"string\"}}}}";
    out = out + ",{\"name\":\"expand_analyze\",\"description\":\"Audit indentation hygiene and defect patterns in text.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"json_mode\":{\"type\":\"boolean\"}}}}";
    out = out + ",{\"name\":\"expand_visualize\",\"description\":\"Output text with visual ruler and tab location markers.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"tab_stops\":{\"type\":\"string\"}}}}";
    out = out + ",{\"name\":\"expand_demo\",\"description\":\"Run multi-scenario synthetic tab expansion showcase.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"json_mode\":{\"type\":\"boolean\"}}}}";
    out = out + "]}}\n";
    return out;
}

pub fn handle_mcp_call(id: String, tool_name: String, req: String) -> String {
    if tool_name == "expand_demo" {
        let json_mode: Bool = json_extract_bool_field(req, "json_mode", false);
        let sample: List[String] = build_sample_code_tabs();
        let opts: ExpandOpts = default_expand_opts();
        let out: String = if json_mode {
            render_json_lines_stream(sample, opts)
        } else {
            "=== Sovereign Tab Expansion Showcase (Go Sample) ===\n" + render_expanded_lines(sample, opts)
        };
        return build_tool_result(id, out);
    }

    if tool_name == "expand_text" {
        let input_text: String = json_extract_str_field(req, "text");
        let stops_str: String = json_extract_str_field(req, "tab_stops");
        let init_flag: Bool = json_extract_bool_field(req, "initial_only", false);
        let mut text_opts: ExpandOpts = default_expand_opts();
        text_opts.initial_only = init_flag;
        if chars_len(stops_str) > 0 {
            text_opts.tab_stops = parse_tab_stops(stops_str);
        }
        let exp_res: String = expand_line(input_text, text_opts);
        return build_tool_result(id, exp_res);
    }

    if tool_name == "expand_file" {
        let stops_val: String = json_extract_str_field(req, "tab_stops");
        let mut file_opts: ExpandOpts = default_expand_opts();
        if chars_len(stops_val) > 0 {
            file_opts.tab_stops = parse_tab_stops(stops_val);
        }
        let sample_lines: List[String] = build_sample_code_tabs();
        let file_rendered: String = render_expanded_lines(sample_lines, file_opts);
        return build_tool_result(id, file_rendered);
    }

    if tool_name == "expand_analyze" {
        let target_text: String = json_extract_str_field(req, "text");
        let j_mode: Bool = json_extract_bool_field(req, "json_mode", false);
        let mut issues: List[IndentationIssue] = list_new();
        if chars_len(target_text) > 0 {
            issues = analyze_line_indent(target_text, 1);
        } else {
            let mixed_sample: List[String] = build_sample_mixed_indent();
            let m_count: Int = list_len(mixed_sample);
            let mut m_i: Int = 0;
            while m_i < m_count {
                let m_line: String = list_get(mixed_sample, m_i);
                let line_issues: List[IndentationIssue] = analyze_line_indent(m_line, m_i + 1);
                let li_count: Int = list_len(line_issues);
                let mut li_idx: Int = 0;
                while li_idx < li_count {
                    issues = list_push(issues, list_get(line_issues, li_idx));
                    li_idx = li_idx + 1;
                }
                m_i = m_i + 1;
            }
        }
        let audit_out: String = if j_mode {
            render_json_audit_report(issues, 10)
        } else {
            render_audit_report(issues, 10)
        };
        return build_tool_result(id, audit_out);
    }

    if tool_name == "expand_visualize" {
        let vis_text: String = json_extract_str_field(req, "text");
        let vis_stops: String = json_extract_str_field(req, "tab_stops");
        let mut vis_opts: ExpandOpts = default_expand_opts();
        vis_opts.visualize = true;
        if chars_len(vis_stops) > 0 {
            vis_opts.tab_stops = parse_tab_stops(vis_stops);
        }
        let line_to_vis: String = if chars_len(vis_text) > 0 { vis_text } else { "\titem1\titem2\titem3" };
        let mut vis_lines: List[String] = list_new();
        vis_lines = list_push(vis_lines, line_to_vis);
        return build_tool_result(id, render_expanded_lines(vis_lines, vis_opts));
    }

    return build_error(id, -32601, "Method or tool not found: " + tool_name);
}

pub fn handle_mcp_message(req: String) -> String {
    let id_str: String = json_extract_str_field(req, "id");
    let id_int: Int = json_extract_int_field(req, "id", -1);
    let id: String = if chars_len(id_str) > 0 {
        "\"" + id_str + "\""
    } else if id_int >= 0 {
        id_int.to_string()
    } else {
        "1"
    };
    let method: String = json_extract_str_field(req, "method");

    if method == "initialize" {
        return render_mcp_init(id);
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return render_mcp_tools_list(id);
    }
    if method == "tools/call" {
        let tool_name: String = json_extract_str_field(req, "name");
        return handle_mcp_call(id, tool_name, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}\n";
    }
    return build_error(id, -32601, "Method not found: " + method);
}

fn find_newline_pos(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn run_mcp_server(fr: &FsReadCap) {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fr, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = find_newline_pos(buf);
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = find_newline_pos(buf);
                }
            }
        }
    }
}
