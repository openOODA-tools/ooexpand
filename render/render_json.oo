// # Tab Expansion JSON Serializer
//
// Logline: Converts expanded lines and whitespace audit findings into RFC 8259 compliant JSON strings.
//
// Setup: Pure string serialization routines producing machine-readable JSON and JSON Lines streams.
//
// Beats:
//   1. Escape character sequences for JSON compliance.
//   2. Serialize expanded line streams into JSON Lines format.
//   3. Output structured JSON defect reports with line coordinates.
//   4. Deliver payloads for automated linting pipelines and MCP clients.

import "core/expand_types.oo";
import "core/expand_engine.oo";

fn json_str_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 92 {
            out = out + "\\\\";
        } else if b == 34 {
            out = out + "\\\"";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

pub fn render_json_lines_stream(lines: List[String], opts: ExpandOpts) -> String {
    let mut out: String = "";
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(lines, i);
        let exp: String = expand_line(line, opts);
        out = out + "{\"line\":" + (i + 1).to_string()
            + ",\"original\":\"" + json_str_escape(line) + "\""
            + ",\"expanded\":\"" + json_str_escape(exp) + "\"}\n";
        i = i + 1;
    }
    return out;
}

pub fn render_json_audit_report(issues: List[IndentationIssue], line_count: Int) -> String {
    let mut out: String = "{\n";
    out = out + "  \"inspected_lines\":" + line_count.to_string() + ",\n";
    let n: Int = list_len(issues);
    out = out + "  \"issue_count\":" + n.to_string() + ",\n";
    out = out + "  \"issues\":[\n";

    let mut i: Int = 0;
    while i < n {
        let issue: IndentationIssue = list_get(issues, i);
        out = out + "    {\"line\":" + issue.line_number.to_string() + ","
            + "\"severity\":\"" + issue.severity + "\","
            + "\"message\":\"" + json_str_escape(issue.message) + "\"}";
        if i + 1 < n {
            out = out + ",";
        }
        out = out + "\n";
        i = i + 1;
    }
    out = out + "  ]\n}";
    return out;
}
