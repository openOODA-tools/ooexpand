# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooexpand-bin
_pkgname=ooexpand
pkgver=0.1.0
pkgrel=1
pkgdesc="Converts tab characters to spaces with custom tab-stop positions and alignment."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooexpand"
license=('Apache-2.0')
depends=('glibc')
provides=('ooexpand')
conflicts=('ooexpand')
source_x86_64=("${url}/releases/download/v${pkgver}/ooexpand-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooexpand-linux-x86_64" "${pkgdir}/usr/bin/ooexpand"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooexpand-uninstall"
}
